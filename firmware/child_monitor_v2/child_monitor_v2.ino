#include <Wire.h>
#include <ArduinoBLE.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include "MAX30105.h"
#include "spo2_algorithm.h"

// ---------- Activity recognition model ----------
// model_data.h: trained model parameters, generated by train_model.py. After retraining, just replace this file
// model_inference.h: feature extraction computeFeatures() and neural network inference classify()
#include "model_data.h"
#include "model_inference.h"

// ---------- Bluetooth ----------
BLEService vitalService("12345678-1234-1234-1234-123456789abc");
BLEStringCharacteristic bpmChar("12345678-1234-1234-1234-123456789abd", BLERead | BLENotify, 20);
BLEStringCharacteristic spo2Char("12345678-1234-1234-1234-123456789abe", BLERead | BLENotify, 20);
BLEStringCharacteristic activityChar("12345678-1234-1234-1234-123456789abf", BLERead | BLENotify, 20);
bool bleOk = false;

// ---------- OLED ----------
Adafruit_SSD1306 display(128, 64, &Wire, -1);
bool oledOk = false;

// ---------- IMU (BMI160) ----------
byte imuAddr = 0x69;
bool imuOk = false;
const float ACC_SCALE = 9.80665 / 4096.0;            // ±8 g range -> m/s^2
const float GYR_SCALE = (1.0 / 16.4) * PI / 180.0;   // ±2000 °/s range -> rad/s

float window[WIN][6];
int filled = 0;            // number of samples currently in the window
int sinceLast = 0;         // samples since the last prediction
int history[3] = {-1, -1, -1};
int activity = -1;         // -1 = no result yet
unsigned long nextImuSample = 0;

// ---------- Heart rate / SpO2 (MAX30102) ----------
MAX30105 heartSensor;
bool heartOk = false;
const int HR_LEN = 100;    // 4 s of data (the sensor outputs 25 samples per second)
const int HR_STEP = 25;    // recompute every 1 s
uint32_t irBuf[HR_LEN];
uint32_t redBuf[HR_LEN];
int hrFill = 0;
const int HIST_N = 7;      // report the median of the last 7 valid results
int hrHist[HIST_N], spHist[HIST_N];
int hrCount = 0, spCount = 0;
int heartRate = -1;        // -1 = no reliable value
int spo2Value = -1;
bool fingerOn = false;
uint32_t lastIr = 0;       // latest infrared reading, used to detect a finger
unsigned long nextHeartPoll = 0;

unsigned long nextReport = 0;

// ---------- IMU ----------
void imuWrite(byte reg, byte val) {
  Wire.beginTransmission(imuAddr);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

bool imuRead(byte reg, byte *buf, byte n) {
  Wire.beginTransmission(imuAddr);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) return false;
  Wire.requestFrom((uint8_t)imuAddr, (size_t)n);
  if (Wire.available() < n) return false;
  for (byte i = 0; i < n; i++) buf[i] = Wire.read();
  return true;
}

bool findImu() {
  byte id;
  imuAddr = 0x69;
  if (imuRead(0x00, &id, 1) && id == 0xD1) return true;
  imuAddr = 0x68;
  if (imuRead(0x00, &id, 1) && id == 0xD1) return true;
  return false;
}

void setupImu() {
  imuWrite(0x7E, 0xB6);   // soft reset
  delay(100);
  imuWrite(0x7E, 0x11);   // accelerometer: normal mode
  delay(50);
  imuWrite(0x7E, 0x15);   // gyroscope: normal mode
  delay(100);
  imuWrite(0x41, 0x08);   // accelerometer range ±8 g (same as when recording the training data)
  imuWrite(0x43, 0x00);   // gyroscope range ±2000 °/s
  delay(10);
}

// Majority of the last 3 predictions, so a single wrong prediction doesn't make the result flicker
int smoothed(int latest) {
  history[0] = history[1]; history[1] = history[2]; history[2] = latest;
  if (history[0] == history[1] && history[0] >= 0) return history[0];
  return latest;
}

void sampleImu() {
  byte raw[12];                                    // gyro XYZ + accelerometer XYZ
  if (!imuRead(0x0C, raw, 12)) return;

  if (filled == WIN) {                             // window full: drop the oldest sample
    memmove(window[0], window[1], sizeof(float) * 6 * (WIN - 1));
    filled = WIN - 1;
  }
  float *s = window[filled++];
  for (int c = 0; c < 3; c++) {
    s[c]     = (int16_t)(raw[7 + 2 * c] << 8 | raw[6 + 2 * c]) * ACC_SCALE;
    s[3 + c] = (int16_t)(raw[1 + 2 * c] << 8 | raw[2 * c]) * GYR_SCALE;
  }

  if (filled < WIN || ++sinceLast < HOP) return;
  sinceLast = 0;
  float f[N_FEAT];
  computeFeatures(window, f);
  activity = smoothed(classify(f));
}

// ---------- Heart rate / SpO2 ----------
void pushValue(int *hist, int *count, int value) {
  if (*count < HIST_N) {
    hist[(*count)++] = value;
  } else {
    for (int i = 1; i < HIST_N; i++) hist[i - 1] = hist[i];
    hist[HIST_N - 1] = value;
  }
}

int median(const int *hist, int count) {
  int tmp[HIST_N];
  for (int i = 0; i < count; i++) tmp[i] = hist[i];
  for (int i = 1; i < count; i++) {
    int key = tmp[i], j = i - 1;
    while (j >= 0 && tmp[j] > key) { tmp[j + 1] = tmp[j]; j--; }
    tmp[j + 1] = key;
  }
  return tmp[count / 2];
}

void resetHeart() {
  hrFill = 0;
  hrCount = 0;
  spCount = 0;
  heartRate = -1;
  spo2Value = -1;
}

// Called once each time the buffer holds 4 s of data
void processHeart() {
  fingerOn = irBuf[HR_LEN - 1] >= 50000;
  if (!fingerOn) {
    resetHeart();
    return;
  }

  int32_t spo2, hr;
  int8_t spo2Valid, hrValid;
  maxim_heart_rate_and_oxygen_saturation(irBuf, HR_LEN, redBuf, &spo2, &spo2Valid, &hr, &hrValid);

  if (hrValid && hr >= 40 && hr <= 180) pushValue(hrHist, &hrCount, hr);
  if (spo2Valid && spo2 >= 80 && spo2 <= 100) pushValue(spHist, &spCount, spo2);
  heartRate = hrCount >= 3 ? median(hrHist, hrCount) : -1;
  spo2Value = spCount >= 3 ? median(spHist, spCount) : -1;

  // Keep the latest 3 s, then recompute after 1 s of new data
  memmove(irBuf, irBuf + HR_STEP, sizeof(uint32_t) * (HR_LEN - HR_STEP));
  memmove(redBuf, redBuf + HR_STEP, sizeof(uint32_t) * (HR_LEN - HR_STEP));
  hrFill = HR_LEN - HR_STEP;
}

// Non-blocking: only reads samples the sensor already has, so the IMU timing is not disturbed
void pollHeart() {
  heartSensor.check();
  while (heartSensor.available()) {
    uint32_t red = heartSensor.getFIFORed();
    uint32_t ir = heartSensor.getFIFOIR();
    heartSensor.nextSample();
    lastIr = ir;
    if (hrFill < HR_LEN) {
      redBuf[hrFill] = red;
      irBuf[hrFill] = ir;
      hrFill++;
    }
    if (hrFill == HR_LEN) processHeart();
  }
}

// ---------- Outputs: LED, display, Bluetooth, serial ----------
void setLed(bool red, bool green, bool blue) {   // on-board LED is active low
  digitalWrite(LEDR, red ? LOW : HIGH);
  digitalWrite(LEDG, green ? LOW : HIGH);
  digitalWrite(LEDB, blue ? LOW : HIGH);
}

void showActivityLed() {
  if (activity == 0) setLed(false, false, true);        // sitting  blue
  else if (activity == 1) setLed(false, true, false);   // standing green
  else if (activity == 2) setLed(true, true, false);    // walking  yellow
  else if (activity == 3) setLed(true, false, false);   // running  red
  else setLed(true, true, true);                        // no result yet: white
}

String valueOrDash(int v) {
  return v > 0 ? String(v) : String("--");
}

void updateDisplay() {
  if (!oledOk) return;
  const char *const LABELS[N_CLASS] = {"SITTING", "STANDING", "WALKING", "RUNNING"};
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(2);
  display.setCursor(0, 0);
  display.print(activity >= 0 ? LABELS[activity] : "--");

  display.setTextSize(1);
  display.setCursor(110, 0);
  display.print(bleOk && BLE.connected() ? "BT" : "");

  display.setCursor(0, 28);
  display.print("HR");
  display.setTextSize(2);
  display.setCursor(30, 24);
  display.print(valueOrDash(heartRate));
  display.setTextSize(1);
  display.setCursor(70, 32);
  display.print(heartOk ? (fingerOn ? "bpm" : "no finger") : "no sensor");

  display.setCursor(0, 50);
  display.print("SpO2");
  display.setTextSize(2);
  display.setCursor(30, 46);
  display.print(valueOrDash(spo2Value));
  display.setTextSize(1);
  display.setCursor(70, 54);
  display.print("%");

  display.display();
}

void publish() {
  if (!bleOk) return;
  bpmChar.writeValue(valueOrDash(heartRate));
  spo2Char.writeValue(valueOrDash(spo2Value));
  activityChar.writeValue(activity >= 0 ? String(ACTIVITY_NAMES[activity]) : String("--"));
}

void report() {
  showActivityLed();
  updateDisplay();
  publish();
  Serial.print("Activity: ");
  Serial.print(activity >= 0 ? ACTIVITY_NAMES[activity] : "--");
  Serial.print("   HR: ");
  Serial.print(valueOrDash(heartRate));
  Serial.print("   SpO2: ");
  Serial.print(valueOrDash(spo2Value));
  Serial.print("   HR sensor: ");
  if (!heartOk) Serial.println("not found");
  else {
    Serial.print(lastIr < 50000 ? "no finger" : (heartRate > 0 ? "ok" : "measuring"));
    Serial.print("  IR: ");
    Serial.println(String((long)lastIr));
  }
}

void showStartup(const char *line1, const char *line2, const char *line3, const char *line4) {
  if (!oledOk) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 0);  display.print(line1);
  display.setCursor(0, 16); display.print(line2);
  display.setCursor(0, 32); display.print(line3);
  display.setCursor(0, 48); display.print(line4);
  display.display();
}

void setup() {
  pinMode(LEDR, OUTPUT);
  pinMode(LEDG, OUTPUT);
  pinMode(LEDB, OUTPUT);
  setLed(true, true, true);
  Serial.begin(115200);                // don't wait for the serial monitor, so it also runs on a power bank
  Wire.begin();
  delay(200);

  oledOk = display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  showStartup("ChildMonitor", "Starting...", "", "");

  for (int i = 0; i < 5 && !imuOk; i++) {
    imuOk = findImu();
    if (!imuOk) delay(200);
  }
  if (imuOk) setupImu();

  for (int i = 0; i < 5 && !heartOk; i++) {
    heartOk = heartSensor.begin(Wire, I2C_SPEED_STANDARD);
    if (!heartOk) delay(200);
  }
  if (heartOk) heartSensor.setup(60, 4, 2, 100, 411, 4096);  // 25 samples per second

  bleOk = BLE.begin();
  if (bleOk) {
    BLE.setLocalName("ChildMonitor");
    BLE.setDeviceName("ChildMonitor");
    BLE.setAdvertisedService(vitalService);
    vitalService.addCharacteristic(bpmChar);
    vitalService.addCharacteristic(spo2Char);
    vitalService.addCharacteristic(activityChar);
    BLE.addService(vitalService);
    publish();
    BLE.advertise();
  }

  Serial.println(imuOk ? "IMU: ok" : "IMU: not found");
  Serial.println(heartOk ? "HR sensor: ok" : "HR sensor: not found");
  Serial.println(bleOk ? "BLE: advertising as ChildMonitor" : "BLE: failed to start");
  showStartup("ChildMonitor",
              imuOk ? "IMU   ok" : "IMU   missing",
              heartOk ? "HR    ok" : "HR    missing",
              bleOk ? "BLE   ok" : "BLE   failed");
  delay(1500);

  nextImuSample = millis();
  nextHeartPoll = millis();
  nextReport = millis() + 1000;
}

void loop() {
  if (bleOk) BLE.poll();
  unsigned long now = millis();

  if (imuOk && (long)(now - nextImuSample) >= 0) {   // IMU: every 50 ms (20 Hz)
    nextImuSample += 50;
    if ((long)(now - nextImuSample) > 0) nextImuSample = now + 50;
    sampleImu();
  }

  if (heartOk && (long)(now - nextHeartPoll) >= 0) { // heart sensor: read new samples every 20 ms
    nextHeartPoll = now + 20;
    pollHeart();
  }

  if ((long)(now - nextReport) >= 0) {               // update LED, display and Bluetooth once per second
    nextReport += 1000;
    report();
  }
}
